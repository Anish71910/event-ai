# Template only. Supply real secrets on the server, not in source control.
APP_ENV=production
DEMO_MODE=0
# Change to razorpay only after configuring and testing the keys/webhook.
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
HTTPS_ONLY=1
SECRET_KEY=
TRUSTED_HOSTS=events.example.com
DATABASE=/var/lib/eventai/events.db
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EVENTAI_WORKER=1
HOST=127.0.0.1
PORT=5000

# Notifications: use the supplied dedicated service in production.
EMAIL_WORKER=0
REMINDER_2H=1
SMTP_FROM=
EMAIL_MESSAGE_DOMAIN=events.example.com
