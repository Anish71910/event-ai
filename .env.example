# Local demo defaults. Copy to .env and adjust as needed.
DEMO_MODE=1
# Choose demo, razorpay or disabled. Start Razorpay with test keys.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=5000
HTTPS_ONLY=0
# Generate a random secret before deployment, or keep the generated instance/secret.key private.
# SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smartevent26@gmail.com
# Gmail App Password (not your normal Gmail password)
SMTP_PASSWORD=

# Local app.py runs its notification worker unless disabled.
EMAIL_WORKER=1
REMINDER_2H=1
SMTP_FROM=
EMAIL_MESSAGE_DOMAIN=eventai.local
